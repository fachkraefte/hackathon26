# Copy to .env.local. Commit names here, never values.
# Copy to .env.local. Commit names here, never values.
# Add the same names in the Vercel project settings.
# Supabase (decided). Fill in once the project exists. Choose an EU region.
# The service role key is server-only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for running migrations locally (Connect → Session pooler). Not needed on Vercel.
# SUPABASE_DB_URL=

# OpenAI (decided). Server-only. Never prefix with NEXT_PUBLIC_.
# Put the real key in .env.local, not here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Demo mode: "an" loads stored, human-checked results if the AI or network fails.
# DEMO_MODUS=an
